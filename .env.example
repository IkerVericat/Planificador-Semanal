# Copia este fichero a .env y rellena los valores:  cp .env.example .env
# Los valores de ejemplo son para el SERVIDOR (producción). En local, mira la sección "Desarrollo" al final.

# Activa Caddy (HTTPS). Déjalo así en el servidor; en local, coméntalo.
COMPOSE_PROFILES=production

# Dominio donde vive la app (sin https://) y correo para los avisos de Let's Encrypt
DOMAIN=planificador.tu-dominio.com
ACME_EMAIL=tu-correo@ejemplo.com

# Laravel (genera la clave con: echo "base64:$(openssl rand -base64 32)")
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# La web y la API comparten dominio: las dos URL son la misma
APP_URL=https://planificador.tu-dominio.com
# Origen del frontend: CORS y enlace del correo de "¿Olvidaste tu contraseña?"
FRONTEND_URL=https://planificador.tu-dominio.com

# PostgreSQL (contraseña larga: openssl rand -base64 24)
DB_DATABASE=planificador
DB_USERNAME=planificador
DB_PASSWORD=

# Correo SMTP (Brevo, Resend, Mailgun, SES…). Puerto 587 = STARTTLS; para 465 pon MAIL_SCHEME=smtps
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-responder@tu-dominio.com
MAIL_FROM_NAME=Planificador

# Puertos en el host (solo accesibles desde el propio equipo: 127.0.0.1)
NGINX_PORT=8080
DB_PORT_HOST=5432

# --- Desarrollo (solo en local; NO lo pongas en el servidor) ---
# COMPOSE_PROFILES=            ← comenta la línea de arriba para no arrancar Caddy
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# APP_URL=http://localhost:8080
# FRONTEND_URL=http://localhost:5173
# MAIL_MAILER=log              ← el enlace de "¿Olvidaste tu contraseña?" sale en `make logs SERVICE=php`
# pgAdmin (solo existe en desarrollo, http://localhost:5050)
# PGADMIN_EMAIL=admin@example.com
# PGADMIN_PASSWORD=
# PGADMIN_PORT=5050
