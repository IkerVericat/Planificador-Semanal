# Copia este fichero a .env y rellena los valores:  cp .env.example .env

# Laravel (genera la clave con: echo "base64:$(openssl rand -base64 32)")
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080

# PostgreSQL
DB_DATABASE=planificador
DB_USERNAME=planificador
DB_PASSWORD=

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=

# Puertos expuestos en el host
NGINX_PORT=8080
PGADMIN_PORT=5050
DB_PORT_HOST=5432
