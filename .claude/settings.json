{
  "permissions": {
    "allow": [
      "Bash(php artisan:*)",
      "Bash(composer install:*)",
      "Bash(composer dump-autoload:*)",
      "Bash(./vendor/bin/pint:*)",
      "Bash(./vendor/bin/pest:*)",
      "Bash(npm run:*)",
      "Bash(npm install)",
      "Bash(npx vitest:*)",
      "Bash(npx vue-tsc:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(composer require:*)",
      "Bash(npm install:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./backend/.env)",
      "Read(./backend/.env.production)",
      "Read(./frontend/.env.production)",
      "Bash(php artisan migrate:fresh --env=production:*)"
    ]
  }
}
